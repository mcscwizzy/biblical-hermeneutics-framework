{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework.canonical_library.schema.base",
  "title": "Canonical Knowledge Library Base Object Schema",
  "description": "Deterministic base schema for CKL objects after governance defaults are applied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "aliases",
    "summary",
    "historical_context",
    "canonical_role",
    "ancient_near_east_context",
    "hebraic_worldview",
    "second_temple_context",
    "canonical_context",
    "later_christian_reception",
    "context_applicability",
    "literary_context",
    "covenantal_significance",
    "authorship_positions",
    "date_ranges",
    "original_audience",
    "historical_setting",
    "genre",
    "structure",
    "major_themes",
    "canonical_placement",
    "key_people",
    "key_places",
    "key_events",
    "interpretive_disputes",
    "primary_sources",
    "intertextuality",
    "timeline",
    "maps",
    "archaeology",
    "hebrew_words",
    "greek_words",
    "related_people",
    "related_places",
    "related_events",
    "related_objects",
    "scripture_references",
    "cross_references",
    "new_testament_connections",
    "interpretive_notes",
    "common_questions",
    "related_entries",
    "keywords",
    "sources",
    "claims",
    "temporal_scope",
    "evidence_items",
    "section_status",
    "knowledge_layers",
    "canonical_story",
    "hermeneutical_lens",
    "retrieval_metadata",
    "importance",
    "framework_version",
    "object_version",
    "content_status",
    "review_status",
    "generated_by",
    "edited_by",
    "reviewed_by",
    "last_reviewed",
    "confidence",
    "human_review_required"
  ],
  "$defs": {
    "canonicalId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "blankableString": {
      "type": "string"
    },
    "kebabCaseString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relationship",
        "weight",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/canonicalId"
        },
        "relationship": {
          "$ref": "#/$defs/kebabCaseString"
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "scriptureReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "relationship",
        "notes"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "type": "string",
          "enum": [
            "primary",
            "supporting",
            "background",
            "quotation",
            "allusion",
            "typology",
            "fulfillment",
            "contrast",
            "parallel"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_type",
        "title",
        "author",
        "publisher",
        "year",
        "locator",
        "url",
        "supports",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/canonicalId"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "scripture",
            "ancient-primary-source",
            "academic-book",
            "journal-article",
            "lexicon",
            "grammar",
            "excavation-report",
            "museum-collection",
            "reference-work",
            "confessional-source",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "locator": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "supports": {
          "$ref": "#/$defs/stringList"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "workflow",
        "date"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ai",
            "human",
            "import",
            "migration",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "interpretiveNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note"
      ],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "note_type": {
          "type": "string",
          "enum": [
            "textual-observation",
            "literary-observation",
            "historical-context",
            "ancient-near-east-context",
            "hebraic-worldview",
            "second-temple-context",
            "canonical-connection",
            "theological-interpretation",
            "interpretive-caution",
            "later-reception"
          ]
        },
        "certainty": {
          "type": "string",
          "enum": [
            "textually_explicit",
            "strong_consensus",
            "probable",
            "plausible",
            "disputed",
            "tradition_dependent",
            "speculative",
            "insufficient_evidence",
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "dispute_status": {
          "type": "string",
          "enum": [
            "not_disputed",
            "minor_scholarly_disagreement",
            "major_scholarly_disagreement",
            "denominational_disagreement",
            "textual_variant",
            "historical_uncertainty",
            "chronological_uncertainty",
            "archaeological_uncertainty",
            "lexical_uncertainty",
            "consensus",
            "broad-consensus",
            "majority",
            "disputed",
            "minority",
            "confessional",
            "unknown"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scripture_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "traditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claim",
        "claim_type",
        "certainty",
        "dispute_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/canonicalId"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "biblical_text",
            "literary",
            "historical_cultural",
            "lexical",
            "archaeology",
            "biblical_theology",
            "systematic_theology",
            "reception_history",
            "denominational_interpretation",
            "pastoral_application"
          ]
        },
        "certainty": {
          "type": "string",
          "enum": [
            "textually_explicit",
            "strong_consensus",
            "probable",
            "plausible",
            "disputed",
            "tradition_dependent",
            "speculative",
            "insufficient_evidence"
          ]
        },
        "dispute_status": {
          "type": "string",
          "enum": [
            "not_disputed",
            "minor_scholarly_disagreement",
            "major_scholarly_disagreement",
            "denominational_disagreement",
            "textual_variant",
            "historical_uncertainty",
            "chronological_uncertainty",
            "archaeological_uncertainty",
            "lexical_uncertainty"
          ]
        },
        "scripture_references": {
          "$ref": "#/$defs/stringList"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonicalId"
          }
        },
        "traditions": {
          "$ref": "#/$defs/stringList"
        },
        "rationale": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "temporalScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_year": {
          "type": ["integer", "null"]
        },
        "end_year": {
          "type": ["integer", "null"]
        },
        "approximate": {
          "type": "boolean"
        },
        "periods": {
          "$ref": "#/$defs/stringList"
        },
        "narrative_setting": {
          "type": "string"
        },
        "source_composition_start_year": {
          "type": ["integer", "null"]
        },
        "source_composition_end_year": {
          "type": ["integer", "null"]
        },
        "source_composition_approximate": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "evidencePassageLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "relationship",
        "temporal_relation",
        "relevance_rationale"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "type": "string",
          "enum": ["direct", "contextual", "comparative", "contrast", "disputed"]
        },
        "temporal_relation": {
          "type": "string",
          "enum": [
            "contemporary",
            "near-contemporary",
            "earlier-comparative",
            "later-comparative",
            "diachronic",
            "unknown"
          ]
        },
        "relevance_rationale": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "evidenceRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relationship"],
      "properties": {
        "id": {
          "$ref": "#/$defs/canonicalId"
        },
        "relationship": {
          "$ref": "#/$defs/kebabCaseString"
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "externalEvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "id"],
      "properties": {
        "domain": {
          "type": "string",
          "enum": ["archaeology-item", "archaeology-site", "map-place", "external-dataset"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "$ref": "#/$defs/kebabCaseString"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "evidenceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_name": {"type": "string"},
        "site_name": {"type": "string"},
        "discovery_location": {"type": "string"},
        "present_location": {"type": "string"},
        "archaeological_period": {"type": "string"},
        "associated_culture": {"type": "string"},
        "associated_biblical_geography": {"type": "string"},
        "image_source_url": {"type": "string"},
        "image_license": {"type": "string"},
        "image_attribution": {"type": "string"}
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "evidence_type",
        "description",
        "assertion_type",
        "confidence",
        "confidence_rationale",
        "passage_relevance",
        "scripture_references",
        "source_ids"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/canonicalId"},
        "title": {"type": "string", "minLength": 1},
        "evidence_type": {
          "type": "string",
          "enum": [
            "artifact",
            "archaeological-site",
            "inscription",
            "ancient-text",
            "manuscript",
            "historical-event",
            "person",
            "people-group",
            "institution",
            "cultural-practice",
            "geography-environment",
            "historical-period",
            "literary-convention",
            "worldview-concept",
            "primary-source",
            "secondary-source",
            "material-culture",
            "other"
          ]
        },
        "description": {"type": "string", "minLength": 1},
        "assertion_type": {
          "type": "string",
          "enum": ["primary-evidence", "secondary-evidence", "scholarly-reconstruction", "inference"]
        },
        "confidence": {
          "type": "string",
          "enum": ["unrated", "low", "medium", "high"]
        },
        "confidence_rationale": {"type": "string", "minLength": 1},
        "passage_relevance": {"type": "string", "minLength": 1},
        "certainty": {
          "type": "string",
          "enum": [
            "textually_explicit",
            "strong_consensus",
            "probable",
            "plausible",
            "disputed",
            "speculative",
            "insufficient_evidence"
          ]
        },
        "dispute_status": {
          "type": "string",
          "enum": [
            "not_disputed",
            "minor_scholarly_disagreement",
            "major_scholarly_disagreement",
            "textual_variant",
            "lexical_uncertainty",
            "historical_uncertainty",
            "chronological_uncertainty",
            "archaeological_uncertainty",
            "identification_uncertainty",
            "interpretive_uncertainty"
          ]
        },
        "primary_observation": {"type": "string"},
        "scholarly_interpretation": {"type": "string"},
        "temporal_scope": {"$ref": "#/$defs/temporalScope"},
        "geography_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/canonicalId"}
        },
        "related_objects": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidenceRelationship"}
        },
        "related_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidenceRelationship"}
        },
        "scripture_references": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidencePassageLink"}
        },
        "source_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/canonicalId"}
        },
        "claim_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/canonicalId"}
        },
        "external_references": {
          "type": "array",
          "items": {"$ref": "#/$defs/externalEvidenceReference"}
        },
        "metadata": {"$ref": "#/$defs/evidenceMetadata"},
        "notes": {"type": "string"}
      }
    },
    "sectionStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_summary",
        "scripture_anchors",
        "historical_context",
        "literary_context",
        "canonical_context",
        "original_audience",
        "lexical_links",
        "intertextuality",
        "interpretive_views",
        "common_misinterpretations",
        "sources",
        "relationships",
        "retrieval_metadata",
        "human_review"
      ],
      "properties": {
        "core_summary": {
          "$ref": "#/$defs/sectionStatusValue"
        },
        "scripture_anchors": {
          "$ref": "#/$defs/sectionStatusValue"
        },
        "historical_context": {
          "$ref": "#/$defs/sectionStatusValue"
        },
        "literary_context": {
          "$ref": "#/$defs/sectionStatusValue"
        },
        "canonical_context": {
          "$ref": "#/$defs/sectionStatusValue"
        },
        "original_audience": {
          "$ref": "#/$defs/sectionStatusValue"
        },
        "lexical_links": {
          "$ref": "#/$defs/sectionStatusValue"
        },
        "intertextuality": {
          "$ref": "#/$defs/sectionStatusValue"
        },
        "interpretive_views": {
          "$ref": "#/$defs/sectionStatusValue"
        },
        "common_misinterpretations": {
          "$ref": "#/$defs/sectionStatusValue"
        },
        "sources": {
          "$ref": "#/$defs/sectionStatusValue"
        },
        "relationships": {
          "$ref": "#/$defs/sectionStatusValue"
        },
        "retrieval_metadata": {
          "$ref": "#/$defs/sectionStatusValue"
        },
        "human_review": {
          "$ref": "#/$defs/sectionStatusValue"
        }
      }
    },
    "sectionStatusValue": {
      "type": "string",
      "enum": [
        "missing",
        "generated",
        "draft",
        "needs_review",
        "reviewed",
        "complete",
        "not_applicable"
      ]
    },
    "knowledgeLayers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/knowledgeLayerValue"
        },
        "secondary": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/knowledgeLayerValue"
          }
        }
      }
    },
    "knowledgeLayerValue": {
      "type": "string",
      "enum": [
        "biblical_text",
        "historical_cultural",
        "ancient_near_eastern",
        "second_temple_jewish",
        "greco_roman",
        "literary",
        "lexical",
        "archaeology",
        "biblical_theology",
        "systematic_theology",
        "reception_history",
        "denominational_interpretation",
        "pastoral_application"
      ]
    },
    "contextApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical",
        "ancient_near_east",
        "hebraic_worldview",
        "second_temple",
        "canonical",
        "later_christian_reception"
      ],
      "properties": {
        "historical": {
          "type": "boolean"
        },
        "ancient_near_east": {
          "type": "boolean"
        },
        "hebraic_worldview": {
          "type": "boolean"
        },
        "second_temple": {
          "type": "boolean"
        },
        "canonical": {
          "type": "boolean"
        },
        "later_christian_reception": {
          "type": "boolean"
        }
      }
    },
    "canonicalStory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "role",
        "preceded_by",
        "followed_by"
      ],
      "properties": {
        "phase": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "preceded_by": {
          "$ref": "#/$defs/stringList"
        },
        "followed_by": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "hermeneuticalLens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immediate_literary_context",
        "book_context",
        "canonical_context",
        "covenant_context",
        "historical_context",
        "ancient_near_east_context",
        "second_temple_jewish_context",
        "original_audience",
        "genre",
        "intertextual_connections",
        "biblical_theology_themes",
        "messianic_christological_trajectory",
        "major_interpretive_views",
        "historical_interpretation",
        "authorial_intent",
        "typological_connections",
        "christological_significance",
        "modern_application_principles",
        "common_misinterpretations"
      ],
      "properties": {
        "immediate_literary_context": {
          "type": "string"
        },
        "book_context": {
          "type": "string"
        },
        "canonical_context": {
          "type": "string"
        },
        "covenant_context": {
          "type": "string"
        },
        "historical_context": {
          "type": "string"
        },
        "ancient_near_east_context": {
          "type": "string"
        },
        "second_temple_jewish_context": {
          "type": "string"
        },
        "original_audience": {
          "type": "string"
        },
        "genre": {
          "type": "string"
        },
        "intertextual_connections": {
          "$ref": "#/$defs/stringList"
        },
        "biblical_theology_themes": {
          "$ref": "#/$defs/stringList"
        },
        "messianic_christological_trajectory": {
          "type": "string"
        },
        "major_interpretive_views": {
          "$ref": "#/$defs/stringList"
        },
        "historical_interpretation": {
          "type": "string"
        },
        "authorial_intent": {
          "type": "string"
        },
        "typological_connections": {
          "$ref": "#/$defs/stringList"
        },
        "christological_significance": {
          "type": "string"
        },
        "modern_application_principles": {
          "$ref": "#/$defs/stringList"
        },
        "common_misinterpretations": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "retrievalMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aliases",
        "search_terms",
        "common_questions",
        "related_topics",
        "frequently_confused_with",
        "semantic_keywords"
      ],
      "properties": {
        "aliases": {
          "$ref": "#/$defs/stringList"
        },
        "search_terms": {
          "$ref": "#/$defs/stringList"
        },
        "common_questions": {
          "$ref": "#/$defs/stringList"
        },
        "related_topics": {
          "$ref": "#/$defs/stringList"
        },
        "frequently_confused_with": {
          "$ref": "#/$defs/stringList"
        },
        "semantic_keywords": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  },
  "properties": {
    "id": {
      "$ref": "#/$defs/canonicalId"
    },
    "type": {
      "type": "string",
      "enum": [
        "theology",
        "theme",
        "person",
        "place",
        "event",
        "book",
        "word_study",
        "archaeology",
        "institution",
        "prophecy",
        "faq",
        "timeline",
        "covenant",
        "biblical_theology",
        "cultural_background",
        "symbol",
        "literary_device",
        "doctrine"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1

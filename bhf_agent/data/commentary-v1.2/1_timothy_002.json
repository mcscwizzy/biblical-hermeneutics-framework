    },
    {
      "kind": "cultural_context",
      "title": "Public Conduct and Status",
      "blocks": [
        {
          "id": "block_3",
          "text": "The instruction about women\u2019s appearance contrasts costly status display\u2014braided hair, gold, pearls, and expensive clothing\u2014with modesty, self-control, and good works. The contrast concerns the kind of public presentation that fits a profession of godliness; it should not be used to shame bodies, demean people by class, or control women\u2019s bodies.",
          "verse_refs": [
            "1 Timothy 2:11-12",
            "1 Timothy 2:12",
            "1 Timothy 2:5-7",
            "1 Timothy 2:7",
            "1 Timothy 2:9-10"
          ],

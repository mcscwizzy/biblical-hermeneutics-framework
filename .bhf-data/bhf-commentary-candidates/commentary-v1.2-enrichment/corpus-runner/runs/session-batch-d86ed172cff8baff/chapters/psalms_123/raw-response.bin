{"reference":"Psalms 123","book":"Psalms","chapter":123,"status":"pending","sections":[{"kind":"surrounding_passages","title":"Nearby Psalms","blocks":[{"id":"block_1","text":"The surrounding collection preserves communal memories of sanctuary destruction and Babylonian exile, alongside thanksgiving for return, festival praise, Torah meditation, and songs oriented toward worship. This is a disputed way of describing the larger setting, but it places Psalm 123’s shared plea for mercy among neighboring communal voices.","verse_refs":["Psalms 120:1-7","Psalms 121:1-8","Psalms 122:1-9","Psalms 124:1-8","Psalms 125:1-5","Psalms 126:1-6","Psalms 127:1-5","Psalms 128:1-6","Psalms 129:1-8","Psalms 130:1-8","Psalms 131:1-3","Psalms 132:1-18","Psalms 133:1-3","Psalms 134:1-3"],"provenance_refs":["reader_path_psalms_123_efd0c9d9283cee6b60b03620"],"confidence":"high","interpretation_level":"disputed"}]}],"generated_metadata":null}
{"reference":"Psalms 146","book":"Psalms","chapter":146,"status":"pending","sections":[{"kind":"surrounding_passages","title":"Within the Psalter","blocks":[{"id":"block_1","text":"Psalm 146 begins the Psalter’s final sequence of praise, Psalms 146–150. This places its repeated call to praise within a closing movement of praise across the collection.","verse_refs":["Psalms 147:1-20","Psalms 148:1-14","Psalms 149:1-9","Psalms 150:1-6"],"provenance_refs":["reader_path_psalms_146_c98bde8f0f2ecbb48ca85c05"],"confidence":"high","interpretation_level":"disputed"}]}],"generated_metadata":null}
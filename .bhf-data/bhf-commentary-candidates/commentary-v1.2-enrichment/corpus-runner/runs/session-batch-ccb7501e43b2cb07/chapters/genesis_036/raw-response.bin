{"reference":"Genesis 36","book":"Genesis","chapter":36,"status":"pending","sections":[{"kind":"surrounding_passages","title":"The larger movement of Genesis","blocks":[{"id":"block_1","text":"The larger literary movement of Genesis shifts from universal beginnings in chapters 1–11 to the ancestral family narratives in chapters 12–50, ending with Jacob's household in Egypt. This places Genesis 36 within that ancestral narrative rather than the book's opening universal section.","provenance_refs":["reader_path_genesis_036_c4d76f5d1a82eee0c81e8edc"],"confidence":"high","interpretation_level":"fact"}]}],"generated_metadata":null}

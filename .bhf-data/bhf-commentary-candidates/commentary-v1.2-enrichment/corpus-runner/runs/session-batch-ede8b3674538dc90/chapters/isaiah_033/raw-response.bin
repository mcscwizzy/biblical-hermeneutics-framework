{"reference":"Isaiah 33","book":"Isaiah","chapter":33,"status":"pending","sections":[{"kind":"surrounding_passages","title":"Isaiah’s Textual Witnesses","blocks":[{"id":"block_1","text":"The Great Isaiah Scroll preserves almost the whole sixty-six-chapter book of Isaiah. It broadly aligns with the Masoretic tradition, though it contains many spelling and substantive differences; other Isaiah manuscripts and interpretive writings from Qumran also show that Isaiah was actively copied and interpreted. This is a disputed area of textual study.","verse_refs":[],"provenance_refs":["reader_path_isaiah_033_f704eaa90f66e350aca6bdf2"],"confidence":"high","interpretation_level":"disputed"}]}],"generated_metadata":null}
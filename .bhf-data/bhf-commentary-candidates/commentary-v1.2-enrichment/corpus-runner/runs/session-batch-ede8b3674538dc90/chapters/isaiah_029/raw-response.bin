{"reference":"Isaiah 29","book":"Isaiah","chapter":29,"status":"pending","sections":[{"kind":"surrounding_passages","title":"Isaiah in Transmission","blocks":[{"id":"block_1","text":"The Great Isaiah Scroll is an almost complete witness to all sixty-six chapters of Isaiah. It broadly agrees with the Masoretic tradition, though it also contains many spelling and substantive differences; other Qumran Isaiah manuscripts and interpretive writings show that Isaiah was actively copied and interpreted.","provenance_refs":["reader_path_isaiah_029_acfa7573f572698ccd9845e3"],"confidence":"high","interpretation_level":"disputed"}]}],"generated_metadata":null}
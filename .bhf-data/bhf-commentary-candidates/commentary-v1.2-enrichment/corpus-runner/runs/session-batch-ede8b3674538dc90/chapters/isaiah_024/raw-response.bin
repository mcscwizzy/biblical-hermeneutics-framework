{"reference":"Isaiah 24","book":"Isaiah","chapter":24,"status":"pending","sections":[{"kind":"surrounding_passages","title":"Isaiah’s Wider Textual Witnesses","blocks":[{"id":"block_1","text":"The Great Isaiah Scroll preserves almost the whole sixty-six-chapter book of Isaiah. It is broadly aligned with the Masoretic tradition, though it contains thousands of spelling and substantive differences; other Qumran Isaiah manuscripts and interpretive writings also reflect active transmission and interpretation of Isaiah. The significance of particular differences remains disputed.","provenance_refs":["reader_path_isaiah_024_ad608a970de69fe69c46bf80"],"confidence":"high","interpretation_level":"disputed"}]}],"generated_metadata":null}
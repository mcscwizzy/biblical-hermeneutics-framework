{"reference":"Genesis 20","book":"Genesis","chapter":20,"status":"pending","sections":[{"kind":"surrounding_passages","title":"History and archaeology","blocks":[{"id":"block_1","text":"The supplied context keeps Mosaic-attribution and compositional models distinct positions because Genesis does not narrate its own literary formation. It also cautions that the absence of direct archaeological identification cannot by itself prove or disprove every ancestral narrative; archaeology and literary interpretation answer different questions.","provenance_refs":["reader_path_genesis_020_889fb054433e077a7442c9ee"],"confidence":"low","interpretation_level":"disputed"}]}],"generated_metadata":null}

{"reference":"Genesis 16","book":"Genesis","chapter":16,"status":"pending","sections":[{"kind":"surrounding_passages","title":"The movement of Genesis","blocks":[{"id":"block_1","text":"Genesis moves from universal origins in chapters 1–11 to ancestral family narratives in chapters 12–50, ending with Jacob's household in Egypt. Genesis 16 belongs within that sustained ancestral family movement.","provenance_refs":["reader_path_genesis_016_2f15825974b4e8f762d4a599"],"confidence":"high","interpretation_level":"fact"}]}],"generated_metadata":null}

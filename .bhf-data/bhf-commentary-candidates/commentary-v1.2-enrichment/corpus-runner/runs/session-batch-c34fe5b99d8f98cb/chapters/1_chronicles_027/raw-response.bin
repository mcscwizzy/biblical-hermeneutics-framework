{"reference":"1 Chronicles 27","book":"1 Chronicles","chapter":27,"status":"pending","sections":[{"kind":"surrounding_passages","title":"The Surrounding Administrative Lists","blocks":[{"id":"block_1","text":"The detailed orders surrounding this chapter may preserve earlier traditions while also reflecting and authorizing later temple institutions. For that reason, it is historically disputed whether these arrangements should be projected directly onto one moment of David’s reign.","verse_refs":["1 Chronicles 23:1-32","1 Chronicles 24:1-31","1 Chronicles 25:1-31","1 Chronicles 26:1-32"],"provenance_refs":["reader_path_1_chronicles_027_b11b765e901cc67e0dd9db86"],"confidence":"medium","interpretation_level":"disputed"}]}],"generated_metadata":null}
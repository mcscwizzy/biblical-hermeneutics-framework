{"reference":"Acts 3","book":"Acts","chapter":3,"status":"pending","sections":[{"kind":"surrounding_passages","title":"Reading Acts in Context","blocks":[{"id":"block_1","text":"Acts 3 narrates particular events and a public speech. Questions about the historical character of Acts are best considered claim by claim, comparing specific details with independent evidence rather than treating the entire work as simply reliable or unreliable.","verse_refs":[],"provenance_refs":["reader_path_acts_003_31937c3e6fcad1331db62183"],"confidence":"high","interpretation_level":"fact"}]}],"generated_metadata":null}
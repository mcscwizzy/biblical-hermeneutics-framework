{"reference":"Luke 17","book":"Luke","chapter":17,"status":"pending","sections":[{"kind":"cultural_context","title":"A Return in Gratitude","blocks":[{"id":"block_1","text":"Luke 17:11-19 describes ten people with a stigmatized skin condition being cleansed, while one—a Samaritan—returns in gratitude. The scene should not be used to stigmatize illness, caricature Samaritans, or turn care for suffering people into spectacle.","verse_refs":["Luke 17:11-19"],"provenance_refs":["reader_path_luke_017_03ed931a23857e162d753a48"],"confidence":"high","interpretation_level":"fact"}]}],"generated_metadata":null}
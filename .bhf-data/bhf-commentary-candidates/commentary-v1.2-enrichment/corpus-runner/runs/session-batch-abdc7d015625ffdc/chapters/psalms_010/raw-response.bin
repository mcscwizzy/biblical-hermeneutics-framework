{"reference":"Psalms 10","book":"Psalms","chapter":10,"status":"pending","sections":[{"kind":"surrounding_passages","title":"Psalm numbering","blocks":[{"id":"block_1","text":"In Greek and Latin Psalter traditions, Psalms 9 and 10 are often combined as one psalm. As a result, the psalm following this one may be numbered differently in editions that follow those traditions.","verse_refs":["Psalms 9:1-20"],"provenance_refs":["reader_path_psalms_010_be62d9b37d295e2c88a7c03b"],"confidence":"high","interpretation_level":"disputed"}]}],"generated_metadata":null}
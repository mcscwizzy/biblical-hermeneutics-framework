{"reference":"Psalms 18","book":"Psalms","chapter":18,"status":"pending","sections":[{"kind":"interpretive_questions","title":"Death imagery","blocks":[{"id":"block_1","text":"The cords of death, overwhelming waters, Sheol, and snares of death are poetic images of mortal peril. They portray the speaker as surrounded by forces that threaten life, heightening the force of his cry for rescue.","verse_refs":["Psalms 18:4-6"],"provenance_refs":["reader_path_psalms_018_cabe53954310e455087b444c"],"confidence":"medium","interpretation_level":"disputed"}]}],"generated_metadata":null}
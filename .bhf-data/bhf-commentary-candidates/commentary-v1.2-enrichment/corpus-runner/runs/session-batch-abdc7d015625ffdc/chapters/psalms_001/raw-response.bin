{"reference":"Psalms 1","book":"Psalms","chapter":1,"status":"pending","sections":[{"kind":"surrounding_passages","title":"Psalms 1–2","blocks":[{"id":"block_1","text":"A debated reading treats Psalms 1 and 2 as an untitled gateway to the Psalms: Psalm 1 introduces flourishing shaped by Torah and the contrasting way of the wicked, while Psalm 2 brings rebellious nations, the LORD’s kingship, and the anointed king into view.","verse_refs":["Psalms 2:1-12"],"provenance_refs":["reader_path_psalms_001_04d6aaa4aa9ea315cf90a5d0"],"confidence":"high","interpretation_level":"disputed"}]}],"generated_metadata":null}
{"reference":"Psalms 13","book":"Psalms","chapter":13,"status":"pending","sections":[{"kind":"interpretive_questions","title":"Lament and trust","blocks":[{"id":"block_1","text":"Psalm 13 gives voice to anguish, protest, and urgent petition before turning to trust, rejoicing, and praise. Its repeated “How long?” shows that direct complaint to God is not excluded from faithful speech; the psalm holds lament and confidence together.","verse_refs":["Psalms 13:1-6"],"provenance_refs":["reader_path_psalms_013_d7e21a348d5d5944113757ff"],"confidence":"high","interpretation_level":"disputed"}]}],"generated_metadata":null}
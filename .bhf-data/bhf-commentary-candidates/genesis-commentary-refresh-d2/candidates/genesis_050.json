          "interpretation_level": "disputed",
          "synthesis_ids": [
            "syn_interpretive_questions_93093f09c340"
          ],
          "text": "The account lingers over Jacob’s death rites: physicians embalm him for forty days, Egypt mourns for seventy days, and a large company including Pharaoh’s officials, chariots, and horsemen accompanies the family toward Canaan. The procession mourns again at the threshing floor of Atad, a place the narrative explains by giving it the name Abel-mizraim. Jacob’s burial is therefore narrated as a public journey from Egypt to the family burial place in Canaan.",
          "verse_refs": [
            "Genesis 50:1-3",
            "Genesis 50:10-11",
            "Genesis 50:2",
            "Genesis 50:22-23",
            "Genesis 50:7-9"
          ]
        }

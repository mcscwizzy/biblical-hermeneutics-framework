    {
      "id": "reader_unit_022",
      "section_kind": "interpretive_questions",
      "section_title": "Interpretive Questions",
      "text": "Galatians cites Abraham's reckoned trust and blessing of nations, contrasts promise and Torah chronology, and focuses seed language on Messiah. Supports gentile inclusion without permitting appropriation that makes Jews strangers to Abraham or their scriptures.",
      "verse_refs": [
        "Genesis 12:3"
      ],
      "evidence_ids": [
        "galatians-abraham-promise-seed",
        "galatians-abraham-promise-seed:passage-relevance"

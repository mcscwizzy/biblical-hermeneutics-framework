    {
      "id": "reader_unit_023",
      "section_kind": "interpretive_questions",
      "section_title": "Interpretive Questions",
      "text": "Galatians reads Abraham's faith and the blessing of the nations as scriptural grounds for gentile reception of the Spirit and inclusion in the promised family.",

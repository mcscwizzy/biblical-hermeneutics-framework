    {
      "id": "reader_unit_019",
      "section_kind": "historical_context",
      "section_title": "Historical Context",
      "text": "The Abrahamic covenant belongs to the patriarchal narratives of Genesis, where divine promise shapes family migration, land expectation, and the identity of Abraham's descendants. Patriarchal narratives in Genesis",
      "verse_refs": [
        "Genesis 12:1-3"
      ],
      "evidence_ids": [

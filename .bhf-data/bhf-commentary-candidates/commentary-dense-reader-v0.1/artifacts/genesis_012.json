    {
      "id": "reader_unit_017",
      "section_kind": "historical_context",
      "section_title": "Historical Context",
      "text": "Abraham stands in the ancestral narratives of Genesis as the father of the covenant line. His story reflects clan migration, land promise, and divine promise in an early biblical setting rather than a fixed modern chronology.",
      "verse_refs": [
        "Genesis 12:1-3"
      ],
      "evidence_ids": [

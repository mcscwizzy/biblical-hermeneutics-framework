    {
      "id": "reader_unit_020",
      "section_kind": "historical_context",
      "section_title": "Historical Context",
      "text": "In the Late Bronze Age, the southern Levant contained Canaanite city-states under substantial Egyptian influence rather than one unified Canaanite empire. The Late Bronze-Iron transition brought uneven political, settlement, and material-cultural changes across highlands, valleys, and coast.",
      "verse_refs": [
        "Genesis 12:5-9"
      ],
      "evidence_ids": [

    {
      "id": "reader_unit_021",
      "section_kind": "interpretive_questions",
      "section_title": "Interpretive Questions",
      "text": "Galatians concludes that those belonging to Messiah are Abraham's seed and heirs according to promise, drawing inheritance into its sustained rereading of Genesis. The scriptural evidence prevents Roman household law from becoming the sole source of the heir and kinship language.",
      "verse_refs": [
        "Genesis 12:1-3"
      ],
      "evidence_ids": [
        "abrahamic-seed-and-inheritance",
        "abrahamic-seed-and-inheritance:passage-relevance"

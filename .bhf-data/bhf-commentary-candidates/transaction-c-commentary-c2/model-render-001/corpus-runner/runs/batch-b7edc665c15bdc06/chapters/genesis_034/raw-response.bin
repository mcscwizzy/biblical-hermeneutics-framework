  "sections": [
    {
      "kind": "archaeology_geography",
      "title": "Public Negotiation and Local Risk",
      "blocks": [
        {
          "id": "block_1",
          "text": "Hamor and Shechem bring their proposal to the city gate, locating the negotiation in a public settlement setting. The chapter also identifies surrounding inhabitants as the people whose response Jacob fears after the attack; this makes his concern in verse 30 intelligible without requiring identification of the city’s exact location or a broader reconstruction of its trade.",
          "verse_refs": [
            "Genesis 34:20-21",
            "Genesis 34:30"
          ],
          "provenance_refs": [
            "reader_path_genesis_034_c16daa78029d427bbf0337e0"
          ],
          "confidence": "high",
          "interpretation_level": "fact"
        }
      ]
    },
    {
      "kind": "surrounding_passages",
      "title": "Genesis in Its Larger Literary Setting",
      "blocks": [
        {
          "id": "block_2",
          "text": "Genesis moves from the universal origins narrated in chapters 1–11 into the ancestral family narratives of chapters 12–50, ending with Jacob’s household in Egypt. Genesis 34 belongs within that extended family narrative.",
          "provenance_refs": [
            "reader_path_genesis_034_df107218abe62d419e7c8a23"
          ],
          "confidence": "high",
          "interpretation_level": "fact"
        },
        {
          "id": "block_3",
          "text": "How Genesis came to be written is not narrated by Genesis itself. Mosaic attribution and compositional models are distinct proposed accounts of its formation, and this remains disputed; the chapter should not be used by itself to settle that question.",
          "provenance_refs": [
            "reader_path_genesis_034_2c3cb591e2398c3131873822"
          ],
          "confidence": "low",
          "interpretation_level": "disputed"
        }
      ]
    }
  ],
  "generated_metadata": null

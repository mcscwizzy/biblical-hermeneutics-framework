    "final_blocks": [
      {
        "block_id": "block_2",
        "section_kind": "language_literary",
        "section_title": "The Opening Census",
        "final_block": "This census belongs to the book’s larger geographical and generational structure. Numbers moves from preparation at Sinai through Kadesh and the Transjordan to renewed preparation on the plains of Moab. The census here and the later census in Numbers 26 frame that journey by counting first the generation at Sinai and then the generation prepared for inheritance near Moab."
      },
      {
        "block_id": "block_3",
        "section_kind": "why_it_matters",
        "section_title": "Why the Census Matters",
        "final_block": "The long enumeration is therefore more than an isolated administrative record. Together with the later census, it marks the transition between two generations and helps give the book its shape as a journey from preparation at Sinai to preparation near Moab."
      }
    ],

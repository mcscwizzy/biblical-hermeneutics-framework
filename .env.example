BHF_HTTP_PORT=8080
# UI/runtime behavior and backend topology are independent. Same-origin is the
# safe default for local, Docker, NAS, and self-hosted PWA deployments.
BHF_RUNTIME_MODE=web
BHF_BACKEND_MODE=same-origin
BHF_API_BASE_URL=
# Set only on a cross-origin backend (for example, Railway) to the exact
# comma-separated frontend origins allowed to call it.
BHF_CORS_ORIGINS=
# Writable runtime databases default beneath this directory. Explicit
# BHF_*_DB_PATH values override their individual derived paths.
BHF_DATA_DIR=.bhf-data
LLM_PROVIDER=openrouter
BHF_BASE_URL=https://openrouter.ai/api/v1
BHF_MODEL=openrouter/free
# Optional when using a browser-connected OpenRouter key instead.
BHF_API_KEY=
BHF_PROFILE=standard
BHF_ANSWER_MODE=study
BHF_TEMPERATURE=0.3
BHF_MAX_TOKENS=1536
BHF_CONTEXT_WINDOW=8192
BHF_TIMEOUT_SECONDS=120
BHF_SHOW_METHOD_NOTES=true
BHF_MEMORY_ENABLED=false
# Copy the image-built lexical database on every container start. Use `missing`
# to preserve an existing .bhf/lexicon.sqlite, or `none` to disable seeding.
BHF_LEXICAL_SEED_POLICY=refresh

# Build and seed the qualified Tyndale Open Study Notes database. Override the
# URL and checksum together only when intentionally refreshing the source.
BHF_COMMENTARY_SEED_POLICY=refresh
BHF_TYNDALE_ARCHIVE_URL=https://tyndaleopenresources.com/wp-content/themes/tyndale-openresources/files/tyndale_open-studynotes.zip
BHF_TYNDALE_ARCHIVE_SHA256=7b4d5ae088449d5a6925170c4b89b978acee2f78f73dc6b8a278fa948a7e8498

# Docker lexical seed build revisions. Override only when intentionally
# refreshing the generated Greek/Hebrew lexical runtime database.
BHF_HEBREW_LEXICON_REVISION=21c9add13bc727d3a951361778e97e3ff7afd1ce
BHF_STRONGS_REVISION=0acd2f251c2d35ff8db2dece4e0593979d3ac223
BHF_OSHB_REVISION=3d15126fb1ef74867fc1434be1942e837932691f
BHF_MORPHGNT_REVISION=aaed91e57c8e4a8dc9a2383e129ca5e75fe6393d

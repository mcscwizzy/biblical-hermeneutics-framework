{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "fluid": true,
  "git": {
    "deploymentEnabled": {
      "master": false
    }
  },
  "functions": {
    "bhf_web/app.py": {
      "maxDuration": 60,
      "excludeFiles": "{.bhf-data/bhf-commentary-candidates/**,build/**}",
      "includeFiles": "{framework/canonical_library/**,framework/commentary/data/tyndale.sqlite}"
    }
  }
}
